{
  "name": "vue-tianditu",
  "version": "3.0.0",
  "description": "vue-tianditu",
  "author": "SoulLyoko <519052532@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangwj888/vue-tianditu.git"
  },
  "homepage": "https://github.com/wangwj888/vue-tianditu#readme",
  "private": false,
  "license": "MIT",
  "main": "./lib/vue-tianditu.umd.cjs",
  "types": "./lib/index.d.ts",
  "keywords": [
    "vue",
    "tianditu",
    "map",
    "skymap",
    "tianmap"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev2": "yarn --cwd examples/vue2 dev",
    "build": "node scripts/build.js",
    "serve": "vite preview",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/docs_build.js",
    "docs:serve": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:examples": "node scripts/check-examples.js",
    "prepare": "husky",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "node scripts/release.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:consumers:browser": "node tests/consumer-browser-smoke.mjs"
  },
  "dependencies": {
    "mitt": "^3.0.1"
  },
  "peerDependencies": {
    "vue": "~2.7.0 || ^3.2.47"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.56.0",
    "prettier": "^3.0.0",
    "sass": "^1.90.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "~7.3.7",
    "vitepress": "1.6.4",
    "vitest": "^4.1.0",
    "vue": "3.5.44",
    "vue-tsc": "^3.3.13",
    "vue-eslint-parser": "^10.3.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts,vue}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "type": "module",
  "module": "./lib/vue-tianditu.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/vue-tianditu.js",
      "require": "./lib/vue-tianditu.umd.cjs"
    },
    "./style.css": "./lib/style.css",
    "./lib/style.css": "./lib/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "^22.22.1 || >=24"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "vitest/vite": "~7.3.7"
  }
}
